# Copy to .env and fill in. Never commit .env.

# Anthropic API key (leave unset to run without a model; /analyze then returns 503)
ANTHROPIC_API_KEY=

# Model ID (see https://platform.claude.com/docs/en/models/overview)
CLAUDE_MODEL=claude-sonnet-5-5

# Token signing key: generate with  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# PII tokenization key (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKENIZATION_KEY=
# Bearer token lifetime in seconds
TOKEN_TTL_SECONDS=900

# Demo accounts are only created when these are set
DEMO_ANALYST_PASSWORD=
DEMO_ADMIN_PASSWORD=

AUDIT_DB=audit.db
LOG_LEVEL=INFO
